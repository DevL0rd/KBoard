#!/usr/bin/env bash
set -uo pipefail

exec 1>&2
export HOME="${HOME:-/root}"
export PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/bin:/bin}"
LIB_DIR=$(dirname "$(readlink -f "$0")")
if [[ ! -r $LIB_DIR/lib.sh ]]; then
    echo "kboard: $LIB_DIR/lib.sh is missing, run ./install.sh from your KBoard checkout once to finish updating"
    exit 0
fi
source "$LIB_DIR/lib.sh"
ID="$UPDATE_ID"
TITLE="$UPDATE_TITLE"
STATE_FILE="${UPDATE_SOURCE_STATE:-$UPDATE_STATE_DIR/source}"

log() {
    printf '%s: %s\n' "$ID" "$*"
}

[[ -r $STATE_FILE ]] || exit 0
mapfile -t state <"$STATE_FILE"
checkout="${state[0]:-}"
owner="${state[1]:-}"
[[ -n $checkout && -n $owner ]] || exit 0
uid=$(id -u "$owner" 2>/dev/null) || exit 0
home=$(getent passwd "$owner" | cut -d: -f6)

as_owner() {
    runuser -u "$owner" -- env -i HOME="$home" USER="$owner" LOGNAME="$owner" PATH="$home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
        LANG="${LANG:-C.UTF-8}" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        GIT_TERMINAL_PROMPT=0 GIT_ASKPASS= GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15" "$@"
}

git_owner() {
    as_owner git -C "$checkout" "$@"
}

pulled=false
pull_updates() {
    if pull_checkout git_owner; then
        pulled=true
        install_update_hook "$checkout"
    fi
    return 0
}

update_needed() {
    $pulled && return 0
    [[ -e $home/.local/state/$ID/update-pending ]] && return 0
    ! as_owner bash -c 'source "$1" && system_built_for "$2"' _ "$LIB_DIR/lib.sh" "$checkout/build/kboard-built-for"
}

if [[ -e $home/.local/state/$ID/install.lock ]] && ! flock -n "$home/.local/state/$ID/install.lock" true; then
    log "an install is running from $checkout, leaving the update to it"
    exit 0
fi
lock_file="$(dirname "$STATE_FILE")/update.lock"
mkdir -p "$(dirname "$lock_file")"
exec 8>"$lock_file"
if ! flock -n 8; then
    log "another update is running, leaving the update to it"
    exit 0
fi
if [[ ! -d $checkout ]]; then
    if [[ -d $home ]]; then
        log "checkout $checkout is gone, removing the system update files; the user-level files in $home stay"
        HOME="$home" bash -c 'source "$1" && remove_system_update_files' _ "$LIB_DIR/lib.sh"
    else
        log "checkout $checkout is gone and $home is missing, skipping"
    fi
    exit 0
fi
if ! git_owner rev-parse --git-dir >/dev/null 2>&1; then
    log "git cannot read $checkout, skipping"
    exit 0
fi
pull_updates
update_needed || exit 0
if [[ -S /run/user/$uid/bus ]]; then
    (cd "$checkout" && as_owner "$checkout/install.sh" --system-update 8>&-)
else
    as_owner mkdir -p "$home/.local/state/$ID"
    as_owner touch "$home/.local/state/$ID/update-pending"
    log "$TITLE will finish updating at your next login"
fi
